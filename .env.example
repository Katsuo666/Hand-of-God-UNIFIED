# Copia este ficheiro para ".env" (na raiz do projeto) e preenche as chaves que tiveres.
# Nenhuma é obrigatória — cada funcionalidade sem chave fica apenas desativada/limitada
# e o resto do projeto continua a funcionar normalmente.
# O .env NUNCA deve ser commitado (já está no .gitignore).

# HaveIBeenPwned — verificação de vazamentos por email (modules/recon/osint_deep.py)
# Obter em: https://haveibeenpwned.com/API/Key (pago)
HIBP_API_KEY=

# Shodan — port/serviço/banner intelligence de um IP (modules/recon/threat_intel.py)
# Obter em: https://account.shodan.io/
SHODAN_API_KEY=

# AbuseIPDB — reputação de IP por reports de abuso (modules/recon/threat_intel.py)
# Obter em: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Twilio Lookup v2 — nome do titular do número (só EUA) + deteção de SIM swap
# (modules/osint/phone.py). Tem crédito de trial grátis ao criar conta.
# Obter em: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# VirusTotal — reputação de IP/domínio/hash/URL (modules/recon/threat_intel.py)
# Obter em: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Hunter.io — descoberta/verificação de emails corporativos (ainda não religado no código novo)
# Obter em: https://hunter.io/api-keys
HUNTER_API_KEY=

# GeoIP local (geoip2) — geolocalização de IP sem depender de API externa a cada consulta
# Regista-te grátis, descarrega GeoLite2-City.mmdb e aponta o caminho aqui:
# https://www.maxmind.com/en/geolite2/signup
GEOIP_DB_PATH=

# Ajustes opcionais (têm default sensato, só define se quiseres mudar)
# HTTP_TIMEOUT=30
# MAX_WORKERS=20
# LOG_LEVEL=INFO
